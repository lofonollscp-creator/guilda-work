# Unidad systemd de la copia con Restic (ver HOSTING.md, «Copia de seguridad con Restic»). Se instala en
# /etc/systemd/system/ junto a restic-backup.timer y se activa el TIMER, no esta unidad. Corre como root a propósito: lee
# /etc/guilda-work.env (modo 600), los volúmenes de Docker y escribe en el segundo disco. Las credenciales están en
# /etc/restic.env (root, 600). RequiresMountsFor: si el segundo disco no está montado, la unidad no arranca (y el script
# además se niega a escribir en el disco principal).

[Unit]
Description=Guilda Work - copia de seguridad con Restic (bases de datos, volúmenes y secretos)
After=docker.service
Requires=docker.service
RequiresMountsFor=/mnt/HC_Volume_106540289

[Service]
Type=oneshot
WorkingDirectory=/home/guilda/guilda-work
EnvironmentFile=/etc/restic.env
ExecStart=/home/guilda/guilda-work/scripts/backup_restic.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
