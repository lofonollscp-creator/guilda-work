     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "guilda-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select n.nodename, n.isactive, n.shouldhaveshards, count(p.shardid) as fragmentos from pg_dist_node n left join pg_dist_shard_placement p on p.nodename=n.nodename group by 1,2,3 order by 1"
