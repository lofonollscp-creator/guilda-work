  {
   "id": 13,
   "type": "table",
   "title": "Sesiones por estado y espera",
   "datasource": {
    "type": "postgres",
    "uid": "guilda-postgres"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "guilda-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select state, coalesce(wait_event_type,'-') as espera, coalesce(wait_event,'-') as evento, usename, count(*) as sesiones, max(extract(epoch from now()-state_change))::int as segundos_max from pg_stat_activity where backend_type='client backend' group by 1,2,3,4 order by sesiones desc"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 14,
   "type": "table",
   "title": "Sentencias más costosas (tiempo total)",
   "datasource": {
    "type": "postgres",
    "uid": "guilda-postgres"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "guilda-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select calls, round(mean_exec_time::numeric,2) as media_ms, round(max_exec_time::numeric,1) as max_ms, round(total_exec_time::numeric/1000,1) as total_s, left(regexp_replace(query,'\\s+',' ','g'),110) as sentencia from pg_stat_statements where dbid=(select oid from pg_database where datname=current_database()) order by total_exec_time desc limit 15"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
