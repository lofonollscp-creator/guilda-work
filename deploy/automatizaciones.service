# Plantilla de unidad systemd para scripts/ejecutar_automatizaciones.py
# en el VPS (ver ese script). Copia a
# /etc/systemd/system/automatizaciones.service, ajusta USUARIO y las
# rutas, y activa el timer (deploy/automatizaciones.timer), no esta
# unidad directamente -- .service sin .timer solo se ejecutaría una vez
# al arrancar el sistema. Mismo patrón exacto que
# vencimientos-fiscales.service.

[Unit]
Description=Guilda Work - reglas de automatización (pasada diaria)
After=network.target

[Service]
Type=oneshot
User=USUARIO
WorkingDirectory=/home/USUARIO/guilda-work
EnvironmentFile=/etc/guilda-work.env
ExecStart=/home/USUARIO/guilda-work/.venv/bin/python scripts/ejecutar_automatizaciones.py
