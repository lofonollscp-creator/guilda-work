# Unidad systemd del BACKOFFICE (proceso independiente de guilda-work.service).
# Copia a /etc/systemd/system/guilda-backoffice.service y:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now guilda-backoffice
#
# Escucha solo en 127.0.0.1:8001; Caddy lo publica como
# backoffice.guildawork.com (ver deploy/Caddyfile). Sus administradores y su
# registro de actividad viven en data/backoffice.db, aparte de la plataforma.

[Unit]
Description=Guilda Work - Backoffice (serve_backoffice.py)
After=network.target

[Service]
Type=simple
User=guilda
WorkingDirectory=/home/guilda/guilda-work
EnvironmentFile=/etc/guilda-work.env
ExecStart=/home/guilda/guilda-work/.venv/bin/python serve_backoffice.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/guilda/guilda-work/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
