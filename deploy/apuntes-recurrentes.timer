# Plantilla de timer systemd para apuntes-recurrentes.service. Copia
# junto al .service a /etc/systemd/system/, luego:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now apuntes-recurrentes.timer
#
# 04:45 -- después de tareas-recurrentes.timer (04:30), mismo
# criterio de escalonar los cron del stack para no competir por CPU/IO.

[Unit]
Description=Guilda Work - generación automática de los apuntes de las plantillas recurrentes (ver apuntes-recurrentes.service)

[Timer]
OnCalendar=*-*-* 04:45:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
