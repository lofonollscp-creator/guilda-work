# Revisión semanal de la base de datos PostgreSQL con el tráfico real (fase 12; scripts/revision_postgres.py): consultas lentas, consultas que tocan todos los fragmentos, tablas con basura,
# índices sin uso, copias y errores. Solo LEE y solo avisa por correo si hay hallazgos (ALERTAS_ADMIN_EMAIL).
#
#   sudo cp deploy/postgres-revision.service deploy/postgres-revision.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now postgres-revision.timer
[Unit]
Description=Guilda Work - revisión semanal de PostgreSQL
After=docker.service

[Service]
Type=oneshot
User=guilda
WorkingDirectory=/home/guilda/guilda-work
EnvironmentFile=/etc/guilda-work.env
ExecStart=/home/guilda/guilda-work/.venv/bin/python scripts/revision_postgres.py --correo --json /home/guilda/guilda-work/data/backups/pg_revision.json
Nice=10
