# Una vez al mes (día 1, 05:00 + hasta 30 min de margen). Persistent=true: si el servidor estaba apagado, se recupera al arrancar.
[Unit]
Description=Guilda Work - prueba mensual de restauración de la copia

[Timer]
OnCalendar=*-*-01 05:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
