msgstr "Uniquement des fournisseurs de l'UE ou de notre propre réseau (les données ne quittent pas l'Europe)"

msgid "Permitir que cada persona use sus propias claves (van antes que las del despacho)"
msgstr "Permettre à chaque personne d'utiliser ses propres clés (elles passent avant celles du cabinet)"

msgid "Al leer facturas con IA"
msgstr "Lors de la lecture des factures avec l'IA"

msgid "La IA propone y una persona siempre revisa"
msgstr "L'IA propose et une personne révise toujours"

msgid "La IA decide sola cuando está segura; una persona revisa el resto"
msgstr "L'IA décide seule quand elle est sûre ; une personne révise le reste"

