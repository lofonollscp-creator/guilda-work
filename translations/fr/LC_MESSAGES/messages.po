msgstr "Pour que le client puisse commenter, il faut d'abord lui montrer la tâche."

msgid "Conversación con el cliente"
msgstr "Conversation avec le client"

msgid "El cliente ve esta tarea en su portal y puede escribir en ella mientras esté abierta."
msgstr "Le client voit cette tâche dans son portail et peut y écrire tant qu'elle est ouverte."

msgid "El cliente ve esta tarea en su portal, pero no puede escribir en ella."
msgstr "Le client voit cette tâche dans son portail mais ne peut pas y écrire."

msgid "Esta tarea ya no se enseña al cliente; la conversación se conserva aquí."
msgstr "Cette tâche n'est plus montrée au client ; la conversation est conservée ici."

msgid "Comentario oculto"
msgstr "Commentaire masqué"

msgid "Ocultar este comentario al cliente"
msgstr "Masquer ce commentaire au client"

msgid "Contestar a"
msgstr "Répondre à"

msgid "Respuesta para el cliente"
msgstr "Réponse pour le client"

