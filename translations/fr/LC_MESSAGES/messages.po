msgstr "Indiquez le motif de l'ajustement."

msgid "Indica los minutos (positivos suman, negativos restan)."
msgstr "Indiquez les minutes (positives : ajout, négatives : retrait)."

msgid "El cifrado de este despacho ya está activado."
msgstr "Le chiffrement de ce cabinet est déjà activé."

msgid "Nivel de reserva no válido."
msgstr "Niveau de confidentialité non valide."

msgid "El cifrado de este despacho no está activado."
msgstr "Le chiffrement de ce cabinet n'est pas activé."

msgid "Tipo de concesión no válido."
msgstr "Type d'autorisation non valide."

msgid "Elige al menos una tarea."
msgstr "Choisissez au moins une tâche."

msgid "El comunicado necesita un título."
msgstr "L'annonce a besoin d'un titre."

msgid "La fecha de fin es anterior a la de inicio."
msgstr "La date de fin est antérieure à la date de début."

msgid "Un movimiento tiene un importe no válido."
msgstr "Un mouvement a un montant non valide."

msgid "Elige al menos un movimiento."
msgstr "Choisissez au moins un mouvement."

