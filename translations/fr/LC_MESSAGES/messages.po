msgstr "CSV (facultatif)"

msgid "Presenta el fichero en la sede de la AEAT (o pásalo a tu colaborador social) y copia aquí el número de justificante que te da: sin él no se podrá rectificar la declaración sin teclearlo."
msgstr "Déposez le fichier sur le site de l'AEAT (ou transmettez-le à votre collaborateur social) et copiez ici le numéro de justificatif qu'il vous donne : sans lui, la déclaration ne pourra être rectifiée sans le saisir."

msgid "Anotar el justificante"
msgstr "Enregistrer le justificatif"

msgid "Esta declaración está presentada sin el número de justificante de 13 cifras; hace falta para poder rectificarla."
msgstr "Cette déclaration a été déposée sans le numéro de justificatif à 13 chiffres ; il est nécessaire pour la rectifier."

msgid "IBAN del titular"
msgstr "IBAN du titulaire"

msgid "Guardar el IBAN"
msgstr "Enregistrer l'IBAN"

msgid "La declaración sale a devolver: el fichero lleva la cuenta en la que se pide la devolución."
msgstr "La déclaration est à rembourser : le fichier porte le compte sur lequel le remboursement est demandé."

msgid "Esta rectificativa lleva la casilla 111: el diseño oficial exige los datos de la cuenta bancaria aunque no se pida devolución."
msgstr "Cette déclaration rectificative comporte la case 111 : le format officiel exige les coordonnées bancaires même sans demande de remboursement."

msgid "Cuentas españolas y de la zona SEPA."
msgstr "Comptes espagnols et de la zone SEPA."

msgid "Resume la nota «%(t)s»"
msgstr "Résume la note « %(t)s »"

msgid "Preguntar al asistente sobre esta nota"
msgstr "Interroger l'assistant sur cette note"

msgid "expediente"
msgid_plural "expedientes"
msgstr[0] "dossier"
msgstr[1] "dossiers"

msgid "Resultado estimado"
msgstr "Résultat estimé"

msgid "Opciones avanzadas"
msgstr "Options avancées"
