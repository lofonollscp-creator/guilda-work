msgstr "L'option n'existe pas."

msgid "Indica un email de facturación válido."
msgstr "Indiquez un e-mail de facturation valide."

msgid "Asigna un plan al tenant antes de activar la suscripción."
msgstr "Attribuez un forfait au tenant avant d'activer l'abonnement."

msgid "El plan todavía no está sincronizado con Stripe (hazlo en Planes y extras)."
msgstr "Le forfait n'est pas encore synchronisé avec Stripe (faites-le dans Forfaits et options)."

msgid "Elige un extra del catálogo."
msgstr "Choisissez une option du catalogue."

msgid "Indica un email de contacto válido para Stripe."
msgstr "Indiquez un e-mail de contact valide pour Stripe."

msgid "Indica el concepto del cobro (máx. 200 caracteres)."
msgstr "Indiquez le libellé de l'encaissement (200 caractères max.)."

msgid "Indica un importe mayor que cero."
msgstr "Indiquez un montant supérieur à zéro."

msgid "El importe no es un número válido."
msgstr "Le montant n'est pas un nombre valide."

msgid "El cobro no existe."
msgstr "L'encaissement n'existe pas."

msgid "Escribe el concepto de la factura."
msgstr "Saisissez le libellé de la facture."

msgid "El importe total es demasiado grande."
msgstr "Le montant total est trop élevé."

msgid "Este despacho no tiene FacturaScripts configurado."
msgstr "Ce cabinet n'a pas configuré FacturaScripts."

msgid "Vincula primero al cliente con FacturaScripts desde su ficha fiscal."
msgstr "Associez d'abord le client à FacturaScripts depuis sa fiche fiscale."

msgid "Elige al menos un parte de horas."
msgstr "Choisissez au moins une feuille d'heures."

