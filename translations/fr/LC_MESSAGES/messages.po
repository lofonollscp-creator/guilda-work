msgstr "Modèle de l'assistant"

msgid "Modelo para leer facturas"
msgstr "Modèle pour lire les factures"

msgid "el mismo del asistente"
msgstr "le même que l'assistant"

msgid "Dirección del servidor (opcional)"
msgstr "Adresse du serveur (facultatif)"

msgid "Claves del despacho (una por línea)"
msgstr "Clés du cabinet (une par ligne)"

msgid "Todavía no hay ninguna clave guardada."
msgstr "Aucune clé n'est encore enregistrée."

msgid "Borrar las claves guardadas"
msgstr "Supprimer les clés enregistrées"

msgid "Probar antes"
msgstr "Essayer plus tôt"

