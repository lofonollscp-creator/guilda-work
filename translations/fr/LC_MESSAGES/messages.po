msgstr "Dernier test réussi il y a %(hace)s : restauration en %(seg)s s avec les mêmes lignes qu'en production."

msgid "Todavía no se ha hecho ningún ensayo de restauración de la base de datos."
msgstr "Aucun test de restauration de la base de données n'a encore été fait."

msgid "El último ensayo falló en: %(fallos)s."
msgstr "Le dernier test a échoué sur : %(fallos)s."

msgid "Conversación cerrada"
msgstr "Conversation fermée"

msgid "Enviado. Tu gestoría recibirá un aviso."
msgstr "Envoyé. Votre cabinet recevra un avis."

msgid "Sobre tu petición"
msgstr "À propos de votre demande"

msgid "Escribe para reabrir la conversación"
msgstr "Écrivez pour rouvrir la conversation"

msgid "Volver a los mensajes"
msgstr "Retour aux messages"

msgid "Escribe a tu gestoría sobre lo que necesites."
msgstr "Écrivez à votre cabinet pour tout ce dont vous avez besoin."

msgid "Tu gestoría recibirá un aviso y te contestará aquí mismo."
msgstr "Votre cabinet recevra un avis et vous répondra ici même."

msgid "También puedes escribir desde un modelo, en Impuestos, o desde una factura, en Facturas."
msgstr "Vous pouvez aussi écrire depuis un modèle, dans Impôts, ou depuis une facture, dans Factures."

msgid "Preguntar a tu gestoría sobre esta petición"
msgstr "Poser une question à votre cabinet sur cette demande"

msgid "Conversaciones con el cliente"
msgstr "Conversations avec le client"

